# Sentra configuration template. Copy to .env for docker compose, or set in your platform's secret manager.
# Never commit real values. All values below are placeholders.

# --- runtime
SENTRA_ENV=development            # production enables strict checks (no dev auth, master key + PostgreSQL required)
PORT=8080
APP_ORIGIN=http://localhost:8080  # must be https:// in production; Keycloak redirect URI = APP_ORIGIN/api/auth/callback

# --- database (PostgreSQL 15+). Either DATABASE_URL or libpq variables. Empty => embedded PGlite (development only).
PGHOST=
PGDATABASE=sentra
PGUSER=sentra
POSTGRES_PASSWORD=<choose-a-local-password>
PGLITE_DIR=./data/pg              # embedded database directory when no PostgreSQL is configured

# --- encryption of stored credentials and server-side OIDC tokens (32 bytes, base64): openssl rand -base64 32
SENTRA_MASTER_KEY=<base64-32-bytes>

# --- identity
AUTH_MODE=keycloak                # keycloak | dev (dev is refused when SENTRA_ENV=production)
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/sentra
KEYCLOAK_PUBLIC_ISSUER=           # only if the browser reaches Keycloak at a different URL than the server
KEYCLOAK_CLIENT_ID=sentra
KEYCLOAK_CLIENT_SECRET=<client-secret-from-keycloak>
KEYCLOAK_ALLOW_HTTP=false         # true only for the local docker realm
KEYCLOAK_ADMIN_PASSWORD=<local-keycloak-admin-password>
SESSION_TTL_SECONDS=28800
SESSION_IDLE_SECONDS=3600

# --- object storage (SBOMs, imports). S3-compatible when S3_BUCKET is set; else local directory.
OBJECT_STORE_DIR=./data/objects
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=

# --- background execution (run workers/scheduler in a separate process in production)
RUN_WORKERS=true
RUN_SCHEDULER=true

# --- AI provider. offline = deterministic planner, no model calls.
AI_PROVIDER=offline               # anthropic | offline
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
ANTHROPIC_API_KEY=<anthropic-api-key>

# --- email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=<smtp-password>
SMTP_FROM=sentra@example.com

# --- integrations
GITHUB_WEBHOOK_SECRET=<github-webhook-secret>
ALLOW_PRIVATE_WEBHOOK_TARGETS=false   # SSRF guard; true only in isolated test environments
EXTERNAL_FEEDS=true                   # OSV/KEV/EPSS syncs during reports
SEED_DEMO=true                        # synthetic demo data on an empty database (never in production)
