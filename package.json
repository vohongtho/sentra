{
  "name": "sentra-platform",
  "private": true,
  "version": "1.0.0",
  "description": "Sentra — Security Intelligence & Alarm Platform (modular monolith)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "npm run build && SENTRA_ENV=development AUTH_MODE=dev PGLITE_DIR=./data/pg OBJECT_STORE_DIR=./data/objects node src/server.mjs",
    "migrate": "node src/migrate-cli.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "eval": "node scripts/eval-agents.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "verify-restore": "node scripts/verify-restore.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "dev:web": "vite"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@aws-sdk/client-ec2": "^3.1175.0",
    "@aws-sdk/client-ecr": "^3.1175.0",
    "@aws-sdk/client-lambda": "^3.1175.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@electric-sql/pglite": "^0.5.17",
    "fflate": "^0.8.3",
    "jose": "^6.2.18",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
